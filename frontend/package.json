{
  "name": "lighttrail-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "node scripts/dump-openapi.mjs && openapi-typescript .openapi.json -o src/api/generated.ts",
    "check:ui": "node scripts/shell-check.mjs",
    "test:r0-6": "node --experimental-strip-types --test tests/r0-6.test.mjs",
    "test:s1-5": "node --experimental-strip-types --test tests/s1-5.test.mjs",
    "check:r0-6-ui": "node scripts/r0-6-browser-check.mjs",
    "check:s1-3-ui": "node scripts/s1-3-browser-check.mjs",
    "check:s1-5-ui": "node scripts/s1-5-browser-check.mjs",
    "check:u1-ui": "node scripts/u1-browser-check.mjs",
    "test:u2-1": "node --experimental-strip-types --test tests/sse.test.mjs tests/requestScope.test.mjs",
    "check:u2-1-ui": "node scripts/u2-1-browser-check.mjs",
    "check:u2-3-ui": "node scripts/u2-3-browser-check.mjs",
    "check:u3-ui": "node scripts/u3-browser-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
