# ============================================================
# LightTrail 环境变量示例（平台中立）
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
#
# 命名约定：
#   - 通用前缀 LLM_：适用于任意 OpenAI 兼容 API，推荐使用；
#   - 兼容别名 ECNU_*：ECNU 平台的旧命名，仍可用；
#   - 两者同时存在时 LLM_* 优先（AliasChoices）。
# 校验：非法值（如 LLM_CONCURRENCY=abc）直接报错，不再静默取默认值。
# ============================================================

# ===== LLM 通用配置（推荐） =====

# API Key（必填）。ECNU 平台在 ChatECNU 左侧「开放平台」申请
LLM_API_KEY=sk-your-token-here

# Base URL（OpenAI 兼容）
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1

# 主对话模型（工具调用链路；默认 ecnu-plus，支持 thinking + 工具调用）
LLM_MODEL=ecnu-plus

# 强推理模型（深度综合；默认 ecnu-max，1M 上下文，支持 thinking / reasoning_effort）
LLM_MODEL_REASON=ecnu-max

# LLM 并发上限（默认 4）：并发是**纯配置**，无平台语义（ADR-004）
#   - 1：等价旧「串行」；平台限流明显时用这一档
#   - 4：默认值，单机现实并发与限流风险的折中
LLM_CONCURRENCY=4

# 兼容别名（只读，B3 批次删除）：LLM_SERIAL_LLM=true 时等价 LLM_CONCURRENCY=1
# LLM_SERIAL_LLM=true

# reason（深推理）通道是否发送 thinking 扩展参数（默认 true，适配 ecnu-max 思考模式）
#   - true ：支持 thinking（思考模式）+ reasoning_effort（思考强度）
#   - false：接口不支持该扩展字段时关闭（SDK 探测 + extra_body 已保证兼容，一般无需关）
LLM_REASON_THINKING=true

# LLM 请求超时（连接,读取；单位秒，默认 30,120）
#   - 读取超时放宽以容忍 thinking 模式下的长响应
# LLM_TIMEOUT=30,120

# ===== 统一护栏（D5，防成本失控与死循环；全部可配置并可在 trace 中看到） =====

# ReAct 单轮工具调用轮数上限（默认 12）
# REACT_MAX_ROUNDS=12

# 单条管线步骤上限（默认 12）
# PIPELINE_MAX_STEPS=12

# 受控规划通道步数上限（默认 8，与 contracts.Plan.max_steps 同源）
# PLAN_MAX_STEPS=8

# ===== 应用配置 =====

# 数据目录（用户档案 / 事件记忆 / 会话数据本地存放，默认 data/，已 gitignore）
# LIGHTTRAIL_DATA_DIR=data

# 配额告警水位（0-1）：LLM 用量超过该水位时给出降级建议，默认 0.9
# LIGHTTRAIL_QUOTA_WARN_THRESHOLD=0.9

# ===== 兼容别名（ECNU 旧命名，二选一即可） =====
# ECNU_API_KEY=sk-your-token-here
# ECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
# ECNU_MODEL=ecnu-plus
# ECNU_MODEL_REASON=ecnu-max