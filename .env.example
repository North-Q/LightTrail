# ============================================================
# LightTrail 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# ============================================================

# 华东师大开发者平台个人 API 令牌（必填）
# 配额后台：ChatECNU 左侧「开放平台」入口
ECNU_API_KEY=sk-your-token-here

# 平台 Base URL（OpenAI 兼容），一般无需修改
ECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1

# 主对话模型：工具调用链路默认使用 ecnu-plus（支持 thinking + 工具调用）
ECNU_MODEL=ecnu-plus

# 强推理模型：ecnu-max（旗舰，1M 上下文，支持 thinking / reasoning_effort）
ECNU_MODEL_REASON=ecnu-max
