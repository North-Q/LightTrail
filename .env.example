# ============================================================
# LightTrail 环境变量示例（平台中立）
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
#
# 命名约定：
#   - 通用前缀 LLM_：适用于任意 OpenAI 兼容 API，推荐使用；
#   - 兼容别名 ECNU_*：ECNU 平台的旧命名，仍可用；
#   - 两者同时存在时 LLM_* 优先。
# ============================================================

# ===== LLM 通用配置（推荐） =====

# API Key（必填）。ECNU 平台在 ChatECNU 左侧「开放平台」申请
LLM_API_KEY=sk-your-token-here

# Base URL（OpenAI 兼容）
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1

# 主对话模型（工具调用链路；默认 ecnu-plus，支持 thinking + 工具调用）
LLM_MODEL=ecnu-plus

# 强推理模型（深度综合；默认 ecnu-max，1M 上下文，支持 thinking / reasoning_effort）
LLM_MODEL_REASON=ecnu-max

# 并发策略：是否串行调用 LLM（默认 true）
#   - true ：适配 ECNU「避免并行请求」建议（默认）
#   - false：接入支持并发的 API（如 DeepSeek 等）时关闭串行
LLM_SERIAL_LLM=true

# ===== 应用配置 =====

# 数据目录（用户档案 / 事件记忆 / 会话数据本地存放，默认 data/，已 gitignore）
# LIGHTTRAIL_DATA_DIR=data

# ===== 兼容别名（ECNU 旧命名，二选一即可） =====
# ECNU_API_KEY=sk-your-token-here
# ECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
# ECNU_MODEL=ecnu-plus
# ECNU_MODEL_REASON=ecnu-max
